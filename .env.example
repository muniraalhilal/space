# ─── Space configuration ─────────────────────────────────────────────────────
# Copy to .env and adjust. Every variable has a safe development default except
# where marked REQUIRED IN PRODUCTION.

NODE_ENV=development
PORT=4000                                   # API port

# Database & cache
DATABASE_URL=postgres://space:space@localhost:5432/space
REDIS_URL=redis://localhost:6379

# REQUIRED IN PRODUCTION: 32+ random characters. Encrypts integration secrets (e.g. GitHub tokens) at rest.
# Generate with: openssl rand -base64 48
APP_ENCRYPTION_KEY=

# Browser origin of the web app (used for CORS on the realtime socket)
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                          # set true behind HTTPS

# File storage: local disk (dev) or any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/files
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=space-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# AI agents. With AI_PROVIDER=none, model-driven runs fail with a clear
# "not configured" message; built-in workflows still work.
AI_PROVIDER=none                             # anthropic | openai | none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
AGENT_RUN_TIMEOUT_SEC=180
AGENT_WORKER_CONCURRENCY=2
GITHUB_API_URL=https://api.github.com

LOG_LEVEL=info

# Web app
API_INTERNAL_URL=http://localhost:4000       # where the Next.js server proxies /api and /realtime
# NEXT_PUBLIC_REALTIME_URL=                  # optional: connect the socket directly (enables WebSocket transport)
