  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  }
}
